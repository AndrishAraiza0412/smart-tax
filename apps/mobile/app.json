{
  "expo": {
    "name": "SmartTax",
    "slug": "smarttax",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "scheme": "smarttax",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.smarttax.app",
      "supportsTablet": true,
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.smarttax.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SmartTax usa Face ID para desbloquear tu sesión de forma segura."
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.REEMPLAZAR-CON-TU-IOS-CLIENT-ID"
        }
      ]
    ]
  }
}
