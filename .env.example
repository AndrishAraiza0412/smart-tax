# SmartTax - Environment Variables
# Copy to .env.local for mobile, configure in Supabase Dashboard for Edge Functions

# ============================================
# MOBILE (Expo) - .env.local
# ============================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Belvo (client-side only needs secret_id for Link token generation)
# Note: For production, generate Link tokens via Edge Function instead
BELVO_SECRET_ID=your-belvo-secret-id
BELVO_SECRET_PASSWORD=your-belvo-secret-password

# ============================================
# EDGE FUNCTIONS (Supabase Dashboard → Settings → Edge Functions → Environment Variables)
# ============================================

# Supabase (auto-injected, but listed for reference)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Factura.com Sandbox (staging.factura.com)
FACTURACOM_USERNAME=your-facturacom-username
FACTURACOM_PASSWORD=your-facturacom-password
FACTURACOM_API_URL=https://staging.factura.com/api
# Optional: pre-generated token to skip auth call
# FACTURACOM_API_TOKEN=your-pre-generated-token

# Belvo Sandbox (sandbox.belvo.com)
BELVO_SECRET_ID=your-belvo-secret-id
BELVO_SECRET_PASSWORD=your-belvo-secret-password
BELVO_WEBHOOK_SECRET=your-webhook-secret-generate-with-openssl-rand-hex-32

# ============================================
# HOW TO GET CREDENTIALS
# ============================================
# 1. Supabase: Create project at supabase.com → Settings → API
# 2. Factura.com: Register at factura.com → Sandbox/Staging credentials
# 3. Belvo: Register at belvo.com → Sandbox credentials → Webhook secret (generate: openssl rand -hex 32)
# 4. Configure Belvo webhook URL: https://your-project.supabase.co/functions/v1/belvo-webhook